import os
import json
import requests


def _get_provider():
    return os.getenv("AI_PROVIDER", "demo").lower()


def _call_openai(prompt: str, system_message: str = "You are a helpful workplace productivity assistant.") -> str:
    api_key = os.getenv("OPENAI_API_KEY")
    if not api_key:
        return ""

    payload = {
        "model": "gpt-4o-mini",
        "messages": [
            {"role": "system", "content": system_message},
            {"role": "user", "content": prompt},
        ],
        "temperature": 0.7,
    }

    response = requests.post(
        "https://api.openai.com/v1/chat/completions",
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
        },
        json=payload,
        timeout=30,
    )

    if response.status_code != 200:
        raise ValueError(f"OpenAI request failed: {response.text}")

    data = response.json()
    return data["choices"][0]["message"]["content"].strip()


def _call_gemini(prompt: str, system_message: str = "You are a helpful workplace productivity assistant.") -> str:
    api_key = os.getenv("GEMINI_API_KEY")
    if not api_key:
        return ""

    payload = {
        "contents": [{
            "parts": [{"text": f"{system_message}\n\n{prompt}"}]
        }]
    }

    response = requests.post(
        f"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key={api_key}",
        json=payload,
        timeout=30,
    )

    if response.status_code != 200:
        raise ValueError(f"Gemini request failed: {response.text}")

    data = response.json()
    candidates = data.get("candidates", [])
    if not candidates:
        return ""

    text = candidates[0].get("content", {}).get("parts", [{}])[0].get("text", "")
    return text.strip()


def _generate_demo_reply(prompt: str) -> str:
    return (
        "Demo mode is active. To use the live model, set the relevant API key in your environment and set AI_PROVIDER to openai or gemini.\n\n"
        f"Prompt summary:\n{prompt[:500]}"
    )


def _run_ai(prompt: str, system_message: str = "You are a helpful workplace productivity assistant.") -> str:
    provider = _get_provider()

    try:
        if provider == "openai":
            result = _call_openai(prompt, system_message)
            if result:
                return result
        elif provider == "gemini":
            result = _call_gemini(prompt, system_message)
            if result:
                return result
    except Exception:
        pass

    return _generate_demo_reply(prompt)


def generate_email(recipient: str, purpose: str, tone: str, details: str) -> str:
    prompt = f"""
Write a {tone.lower()} email to {recipient} about {purpose}.
Include the following details:
{details or 'No extra details provided.'}

Make it concise, professional, and easy to send.
"""
    return _run_ai(prompt, "You write polished workplace emails.")


def summarize_meeting(notes: str) -> str:
    prompt = f"""
Summarize the following meeting notes into a clear executive summary with:
- key decisions
- action items
- owners
- open questions

Meeting notes:
{notes}
"""
    return _run_ai(prompt, "You summarize meetings clearly and professionally.")


def plan_tasks(goal: str, constraints: str) -> str:
    prompt = f"""
Create a practical task plan for the following goal:
Goal: {goal}
Constraints: {constraints or 'No major constraints noted.'}

Return:
1. Clear milestones
2. Prioritized tasks
3. Time estimates
4. Dependencies
5. Risks and mitigations
"""
    return _run_ai(prompt, "You create structured work plans and priorities.")


def research_assistant(topic: str) -> str:
    prompt = f"""
Create a concise research brief on the topic below:
Topic: {topic}

Include:
- overview
- key points
- risks or challenges
- recommended next steps
"""
    return _run_ai(prompt, "You produce concise, business-friendly research briefs.")


def chatbot_response(user_input: str) -> str:
    prompt = f"""
Answer the user request in a helpful, practical, and concise way.

User request:
{user_input}
"""
    return _run_ai(prompt, "You act as a helpful workplace AI assistant.")


